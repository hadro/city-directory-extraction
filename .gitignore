# data + model artifacts (large; regenerate or download)
# `data/*` rather than `data/`: git cannot re-include a file whose parent DIRECTORY is excluded,
# and the hand-labelled bands at the bottom of this file are the one thing in here that is not
# regenerable. Everything else under data/ is still ignored exactly as before.
data/*
models/
outputs/
*.jsonl
*.parquet

# the HPC shipping tarball (rebuild with `bash hpc/make_bundle.sh`)
cde-hpc-bundle-*.tar.gz

# generated locally from pipeline output (census surnames.tsv IS committed as the seed)
data_prep/names/surnames_harvested.tsv
data_prep/names/given_harvested.tsv
data_prep/master_directories.pending.csv
# IA metadata API cache for backfill_contributor.py (re-fetchable, ~10s)
data_prep/.ia_contributor_cache.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# secrets / env
.env
*.env

# os / editor
.DS_Store
.vscode/
.idea/
/preds*.txt

# Claude
.claude/
# generated labeling tools (3 MB each, rebuild with data_prep/make_gold_tool.py)
gold_*.html

# Local
notes.md

# Hand-labelled band data — 239 leaves, ~90 minutes of human labelling, NOT regenerable.
# Everything else under data/ can be rebuilt from IA; this cannot. Negations must come last,
# since the final matching pattern wins and both `data/*` and `*.jsonl` match these.
!data/bands_*.jsonl